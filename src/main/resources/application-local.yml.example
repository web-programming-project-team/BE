# 이 파일을 application-local.yml로 복사해 값을 채운다 (application-local.yml은 커밋하지 않음)
# username/password는 루트 .env의 DB_USER/DB_PASSWORD와 같아야 한다
spring:
  datasource:
    url: jdbc:mysql://localhost:3306/next_siheung?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
    username: nextstep
    password: change-me
  jpa:
    hibernate:
      ddl-auto: update        # 로컬 초기 개발만. ERD 확정 후 validate + 마이그레이션 도입 검토
    show-sql: true

app:
  seed:
    roadmap-templates: true   # 로드맵 템플릿 4개. 단계 정책은 온통청년 수집 정책으로 자동 연결 (ontong-api-key 필요)
  jwt:
    secret: change-me-to-a-random-256-bit-base64-string
  external:
    ontong-api-key: ""
    gg-job-api-key: ""        # 경기데이터드림 인증키 (잡아바 채용정보 GGJOBABARECRUSTM)
